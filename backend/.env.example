PORT=4000

# Used to sign login sessions. Change this to a long random string.
JWT_SECRET=replace-this-with-a-long-random-string

# Used to encrypt saved server credentials (SSH passwords/private keys) at rest.
# Must be exactly 32 characters.
CREDENTIALS_KEY=replace-this-with-32-char-secret

# Comma separated list of origins allowed to call the API (your frontend URL)
CORS_ORIGIN=http://localhost:5173
